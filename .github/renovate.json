{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "github>zewelor/renovate-config//presets/github-actions"],
  "enabledManagers": ["github-actions", "pip_requirements"],
  "timezone": "Europe/Lisbon",
  "schedule": ["* * * * 1"],
  "internalChecksFilter": "strict",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "ignoreTests": false,
  "ignoreDeps": ["homeassistant", "pytest-homeassistant-custom-component", "skills-ref"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with", "github-runner"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "pinDigests": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchManagers": ["pip_requirements"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements_dev.txt"],
      "matchPackageNames": ["colorlog", "isal", "zlib_ng", "zlib-ng"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Python development dependencies",
      "automerge": true
    }
  ]
}
